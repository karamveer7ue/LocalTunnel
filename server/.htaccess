# Every request goes through index.php: the dashboard, the client API, and all tunneled
# traffic, including paths that look like files on this server.

# Apache running PHP as a module reads these. PHP-FPM and CGI read .user.ini instead.
<IfModule mod_php.c>
    php_flag enable_post_data_reading off
    php_flag zlib.output_compression off
    php_value output_buffering 0
</IfModule>
<IfModule mod_php7.c>
    php_flag enable_post_data_reading off
    php_flag zlib.output_compression off
    php_value output_buffering 0
</IfModule>

<IfModule mod_env.c>
    # Responses stream through as they arrive, and tunneled apps compress on their own.
    SetEnv no-gzip 1
    SetEnv dont-vary 1
    # Uploads sent without a Content-Length (chunked) would otherwise reach PHP-FPM empty.
    SetEnv proxy-sendcl 1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Apache drops the Authorization header before it reaches PHP-FPM; pass it along.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
